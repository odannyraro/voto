{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/model.ts",
    "!src/context.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "tempDirName": ".stryker-tmp",
  "tsconfigFile": "tsconfig.stryker.json"
}
